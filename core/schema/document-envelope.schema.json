{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ajila.com/schemas/document-envelope.schema.json",
  "title": "DocumentEnvelope",
  "description": "Top-level structured representation produced by the forms-conversion pipeline. Mirrors the serde JSON serialization of `core::structured::DocumentEnvelope`. Fields marked `#[serde(skip)]` in Rust (e.g. SOM paths, raw image bytes, source names) are intentionally absent.",
  "$ref": "#/$defs/DocumentEnvelope",
  "$defs": {
    "DocumentEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context", "content"],
      "properties": {
        "context": { "$ref": "#/$defs/Context" },
        "content": {
          "type": "array",
          "items": { "$ref": "#/$defs/StructuredNode" }
        },
        "stateCount": {
          "type": "integer",
          "minimum": 0,
          "default": 1,
          "description": "Number of exhaustive form states merged to produce this envelope."
        }
      }
    },

    "Context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language"],
      "properties": {
        "language": {
          "type": "string",
          "description": "Document language (e.g. \"de\", \"en\", \"fr\")."
        },
        "variables": {
          "type": "object",
          "description": "XFA <variables><text> values keyed by name. Omitted when empty.",
          "additionalProperties": { "type": "string" }
        }
      }
    },

    "StructuredNode": {
      "description": "Internally tagged on `type`.",
      "oneOf": [
        { "$ref": "#/$defs/HeadingNode" },
        { "$ref": "#/$defs/ParagraphNode" },
        { "$ref": "#/$defs/ImageNode" },
        { "$ref": "#/$defs/TableNode" },
        { "$ref": "#/$defs/FieldNode" },
        { "$ref": "#/$defs/RepeatableNode" },
        { "$ref": "#/$defs/GroupNode" },
        { "$ref": "#/$defs/ConditionalNode" },
        { "$ref": "#/$defs/EmptyNode" },
        { "$ref": "#/$defs/GridLayout" },
        { "$ref": "#/$defs/ListNode" },
        { "$ref": "#/$defs/FootnoteNode" }
      ]
    },

    "HeadingNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "level", "content"],
      "properties": {
        "type": { "const": "heading" },
        "level": { "$ref": "#/$defs/HeadingLevel" },
        "content": { "$ref": "#/$defs/TranslatedText" }
      }
    },

    "ParagraphNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "content"],
      "properties": {
        "type": { "const": "paragraph" },
        "content": { "$ref": "#/$defs/TranslatedText" }
      }
    },

    "ImageNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "altText"],
      "properties": {
        "type": { "const": "image" },
        "altText": {
          "type": ["string", "null"],
          "description": "Image bytes themselves are not serialized."
        }
      }
    },

    "TableNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "header", "rows", "caption"],
      "properties": {
        "type": { "const": "table" },
        "header": {
          "oneOf": [{ "$ref": "#/$defs/TableHeader" }, { "type": "null" }]
        },
        "rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/TableRow" }
        },
        "caption": {
          "oneOf": [{ "$ref": "#/$defs/TranslatedText" }, { "type": "null" }]
        }
      }
    },

    "TableHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cells"],
      "properties": {
        "cells": {
          "type": "array",
          "items": { "$ref": "#/$defs/StructuredNode" }
        }
      }
    },

    "TableRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cells"],
      "properties": {
        "cells": {
          "type": "array",
          "items": { "$ref": "#/$defs/StructuredNode" }
        }
      }
    },

    "FieldNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name", "label", "inputType", "value", "placeholder"],
      "properties": {
        "type": { "const": "field" },
        "name": { "$ref": "#/$defs/FieldId" },
        "label": {
          "oneOf": [{ "$ref": "#/$defs/TranslatedText" }, { "type": "null" }]
        },
        "inputType": { "$ref": "#/$defs/FieldType" },
        "value": {
          "oneOf": [{ "$ref": "#/$defs/InputValue" }, { "type": "null" }]
        },
        "placeholder": {
          "oneOf": [{ "$ref": "#/$defs/TranslatableString" }, { "type": "null" }]
        },
        "required": { "type": "boolean", "default": false }
      }
    },

    "RepeatableNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "item", "minOccurrences", "maxOccurrences"],
      "properties": {
        "type": { "const": "repeatable" },
        "item": { "$ref": "#/$defs/StructuredNode" },
        "minOccurrences": { "type": "integer", "minimum": 0 },
        "maxOccurrences": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    },

    "GroupNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "children"],
      "properties": {
        "type": { "const": "group" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/StructuredNode" }
        }
      }
    },

    "ConditionalNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "condition", "content"],
      "properties": {
        "type": { "const": "conditional" },
        "condition": { "$ref": "#/$defs/FieldCondition" },
        "content": { "$ref": "#/$defs/StructuredNode" }
      }
    },

    "EmptyNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "empty" }
      }
    },

    "GridLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "columns", "elements"],
      "properties": {
        "type": { "const": "gridLayout" },
        "columns": { "type": "integer", "minimum": 0 },
        "elements": {
          "type": "array",
          "items": { "$ref": "#/$defs/GridLayoutElement" }
        }
      }
    },

    "GridLayoutElement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["span", "node"],
      "properties": {
        "span": { "type": "integer", "minimum": 0 },
        "node": { "$ref": "#/$defs/StructuredNode" }
      }
    },

    "ListNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "listStyle", "items"],
      "properties": {
        "type": { "const": "list" },
        "listStyle": { "$ref": "#/$defs/ListStyleType" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/ListItem" }
        }
      }
    },

    "ListItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content"],
      "properties": {
        "content": { "$ref": "#/$defs/TranslatedText" },
        "sublist": { "$ref": "#/$defs/ListNodeInner" }
      }
    },

    "ListNodeInner": {
      "description": "A nested list. Same shape as ListNode but without the `type` discriminant (it appears as the `sublist` of a ListItem, not as a StructuredNode).",
      "type": "object",
      "additionalProperties": false,
      "required": ["listStyle", "items"],
      "properties": {
        "listStyle": { "$ref": "#/$defs/ListStyleType" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/ListItem" }
        }
      }
    },

    "FootnoteNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "content"],
      "properties": {
        "type": { "const": "footnote" },
        "content": { "$ref": "#/$defs/TranslatedText" },
        "marker": {
          "type": "string",
          "description": "Footnote marker (e.g. \"1\"). Omitted when absent."
        }
      }
    },

    "FieldCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fieldName", "value"],
      "properties": {
        "fieldName": { "$ref": "#/$defs/FieldId" },
        "value": { "$ref": "#/$defs/InputValue" }
      }
    },

    "FieldType": {
      "description": "Internally tagged on `type`.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "regex", "maxLength", "minLength"],
          "properties": {
            "type": { "const": "text" },
            "regex": { "type": ["string", "null"] },
            "maxLength": { "type": ["integer", "null"], "minimum": 0 },
            "minLength": { "type": ["integer", "null"], "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "maxLength"],
          "properties": {
            "type": { "const": "textarea" },
            "maxLength": { "type": ["integer", "null"], "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "min", "max", "step"],
          "properties": {
            "type": { "const": "number" },
            "min": { "$ref": "#/$defs/DecimalOrNull" },
            "max": { "$ref": "#/$defs/DecimalOrNull" },
            "step": { "$ref": "#/$defs/DecimalOrNull" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "date" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "email" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "tel" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "bool" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "options"],
          "properties": {
            "type": { "const": "radio" },
            "options": {
              "type": "array",
              "items": { "$ref": "#/$defs/NameValue" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "options"],
          "properties": {
            "type": { "const": "select" },
            "options": {
              "type": "array",
              "items": { "$ref": "#/$defs/NameValue" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "options"],
          "properties": {
            "type": { "const": "checkboxGroup" },
            "options": {
              "type": "array",
              "items": { "$ref": "#/$defs/NameValue" }
            }
          }
        }
      ]
    },

    "NameValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "$ref": "#/$defs/TranslatableString" },
        "value": { "$ref": "#/$defs/InputValue" }
      }
    },

    "InputValue": {
      "description": "Adjacently tagged: discriminant in `type`, payload in `value`.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "text" },
            "value": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "number" },
            "value": { "$ref": "#/$defs/Decimal" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "bool" },
            "value": { "type": "boolean" }
          }
        }
      ]
    },

    "TranslatableString": {
      "description": "Untagged: either a plain string, or a map of language code → text (null = translation not provided).",
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "additionalProperties": { "type": ["string", "null"] }
        }
      ]
    },

    "TranslatedText": {
      "description": "Transparent newtype over a map of language code → InlineText (independent formatting per language).",
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/InlineText" }
    },

    "InlineText": {
      "description": "Transparent newtype over a sequence of inline nodes.",
      "type": "array",
      "items": { "$ref": "#/$defs/InlineNode" }
    },

    "InlineNode": {
      "description": "Adjacently tagged: discriminant in `type`, payload in `content`.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "content"],
          "properties": {
            "type": { "const": "text" },
            "content": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "content"],
          "properties": {
            "type": { "const": "link" },
            "content": { "$ref": "#/$defs/LinkNode" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "content"],
          "properties": {
            "type": { "const": "strong" },
            "content": { "$ref": "#/$defs/InlineNode" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "content"],
          "properties": {
            "type": { "const": "emphasis" },
            "content": { "$ref": "#/$defs/InlineNode" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "content"],
          "properties": {
            "type": { "const": "superscript" },
            "content": { "$ref": "#/$defs/InlineNode" }
          }
        }
      ]
    },

    "LinkNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["href", "content"],
      "properties": {
        "href": { "type": "string" },
        "content": { "$ref": "#/$defs/InlineText" }
      }
    },

    "HeadingLevel": {
      "type": "string",
      "enum": ["h1", "h2", "h3", "h4", "h5", "h6"]
    },

    "ListStyleType": {
      "type": "string",
      "enum": [
        "disc",
        "circle",
        "square",
        "dash",
        "decimal",
        "lower-alpha",
        "upper-alpha",
        "lower-roman",
        "upper-roman"
      ]
    },

    "FieldId": {
      "type": "string",
      "format": "uuid",
      "description": "Deterministic UUID v5 derived from the field's SOM path.",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },

    "Decimal": {
      "description": "rust_decimal value. Serialized as a string by default (no serde-float/arbitrary-precision feature enabled); a JSON number is also accepted.",
      "type": ["string", "number"]
    },

    "DecimalOrNull": {
      "oneOf": [{ "$ref": "#/$defs/Decimal" }, { "type": "null" }]
    }
  }
}
