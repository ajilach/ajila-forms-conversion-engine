/target
.DS_Store

# Staged mcp sidecar binary for `dx bundle` (built in CI, see release.yml).
# Repo-root, because dx resolves [bundle].external_bin relative to its CWD.
/sidecar

/cli/*.png
/cli/*.json
/cli/*.html
/cli/*.xml
/cli/*.zip
/cli/*.dot
/cli/*.xsd

/judge/*.csv

/specs/migrated

