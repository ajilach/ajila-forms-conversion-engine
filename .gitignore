*.plain.png
*_merged.json
*_merged.zip
*_multilingual.json
*_multilingual.zip

# Temporary extraction directories created during XML patching
_pkg_tmp/
_frag_tmp/
_check_tmp/
*_merged/
*_merged */

.env
