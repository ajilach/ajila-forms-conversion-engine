{
    "[rust]": {
        "editor.defaultFormatter": "rust-lang.rust-analyzer",
        "editor.formatOnSave": true,
    },
    "rust-analyzer.check.command": "clippy",
    "chat.tools.terminal.autoApprove": {
        "cat": true,
        "jq": true,
        "grep": true,
        "head": true,
        "tail": true,
        "wc": true,
        "ls": true,
        "pwd": true,
        "echo": true,
        "git status": true,
        "git diff": true,
        "git log": true,
        "git stash": true,
        "git stash pop": true,
        "cargo": true,
        "cargo check": true,
        "cargo test": true,
        "true": true,
        "false": true,
        "diff": true
    },
    "chat.tools.urls.autoApprove": {
        "https://github.com": true,
        "https://*.adobe.com": true,
        "https://*.githubusercontent.com": true,
        "https://docs.rs": true,
        "https://crates.io": true,
        "https://*.github.io": true,
        "https://stackoverflow.com": true,
        "https://*.rust-lang.org": true,
        "https://developer.mozilla.org": true
    },
    "chat.agent.maxRequests": 100,
    "chat.tools.edits.autoApprove": {
        "/tmp": true,
    },
    // "chat.tools.autoApprove": true
}