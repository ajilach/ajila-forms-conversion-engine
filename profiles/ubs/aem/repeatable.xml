<{{ element_name }}
    jcr:created="{Date}2025-01-01T00:00:00.000Z"
    jcr:createdBy="{{ author }}"
    jcr:lastModified="{Date}2025-01-01T00:00:00.000Z"
    jcr:lastModifiedBy="{{ author }}"
    jcr:primaryType="nt:unstructured"
    sling:resourceType="{{ variables.resource_type_base }}/panel"
    dorExcludeDescription="true"
    dorExcludeTitle="true"
    guideNodeClass="guidePanel"
    name="{{ name }}"
    textIsRich="true"
    validateOnStepCompletion="{Boolean}false"{{ extra_attributes }}>
    <layout jcr:primaryType="nt:unstructured" sling:resourceType="{{ variables.default_layout }}" columns="1" dorLayoutType="columnar" dorNumCols="1" nonNavigable="{Boolean}true" toolbarPosition="Bottom"/>
    <items jcr:primaryType="nt:unstructured" sling:resourceType="{{ variables.default_layout }}">
        <repeatableInner
            jcr:created="{Date}2025-01-01T00:00:00.000Z"
            jcr:createdBy="{{ author }}"
            jcr:lastModified="{Date}2025-01-01T00:00:00.000Z"
            jcr:lastModifiedBy="{{ author }}"
            jcr:primaryType="nt:unstructured"
            sling:resourceType="{{ variables.custom_resource_type_base }}/controls/panel"
            {% if bind_ref %}bindRef="{{ bind_ref }}"
            {% endif %}dorExcludeDescription="true"
            dorExcludeTitle="true"
            guideNodeClass="guidePanel"
            maxOccur="{{ max_occur }}"
            minOccur="{{ min_occur }}"
            name="{{ panel_name }}"
            textIsRich="true"
            validateOnStepCompletion="{Boolean}false">
            <layout jcr:primaryType="nt:unstructured" sling:resourceType="{{ variables.default_layout }}" columns="1" dorLayoutType="columnar" dorNumCols="1" nonNavigable="{Boolean}true" toolbarPosition="Bottom"/>
            <items jcr:primaryType="nt:unstructured" sling:resourceType="{{ variables.default_layout }}">
                <panel_copy_copy
                    jcr:created="{Date}2025-01-01T00:00:00.000Z"
                    jcr:createdBy="{{ author }}"
                    jcr:lastModified="{Date}2025-01-01T00:00:00.000Z"
                    jcr:lastModifiedBy="{{ author }}"
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="{{ variables.custom_resource_type_base }}/controls/panel"
                    dorExcludeDescription="true"
                    dorExcludeTitle="true"
                    guideNodeClass="guidePanel"
                    name="{{ title }}_inner"
                    textIsRich="true"
                    validateOnStepCompletion="{Boolean}false">
                    <layout jcr:primaryType="nt:unstructured" sling:resourceType="{{ variables.default_layout }}" columns="1" dorLayoutType="columnar" dorNumCols="1" nonNavigable="{Boolean}true" toolbarPosition="Bottom"/>
                    <items jcr:primaryType="nt:unstructured" sling:resourceType="{{ variables.default_layout }}">
                        {{ children }}
                    </items>
                    <cq:responsive jcr:primaryType="nt:unstructured">
                        <default jcr:primaryType="nt:unstructured" offset="0" width="12"/>
                    </cq:responsive>
                </panel_copy_copy>
                <removebutton
                    jcr:created="{Date}2025-01-01T00:00:00.000Z"
                    jcr:createdBy="{{ author }}"
                    jcr:lastModified="{Date}2025-01-01T00:00:00.000Z"
                    jcr:lastModifiedBy="{{ author }}"
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="{{ variables.custom_resource_type_base }}/controls/removebutton"
                    dorExclusion="true"
                    dorFieldStyling="{{ variables.dor_field_styling }}"
                    guideNodeClass="guideButton"
                    name="BT_Remove"
                    textIsRich="[true,true]"
                    type="Button"
                    visible="{Boolean}false">
                    <fd:rules jcr:primaryType="nt:unstructured"/>
                    <fd:scripts fd:click="[{&quot;script&quot;:{&quot;content&quot;:&quot;{{ panel_name }}.instanceManager.removeInstance(this.parent.index);\var len = {{ panel_name }}.instanceManager.instances.length;\for (var i = 0; i &lt; len; i++) {\{{ panel_name }}.instanceManager.instances[i].BT_Remove.visible = (i === (len - 1) &amp;&amp; len &gt; 1) ? true : false;\}\if (len &lt; {{ max_occur }}) {\{{ name }}.BT_Add.visible = true;\}&quot;\,&quot;event&quot;:&quot;Click&quot;\,&quot;field&quot;:&quot;BT_Remove&quot;}\,&quot;nodeName&quot;:&quot;SCRIPTMODEL&quot;\,&quot;version&quot;:1\,&quot;enabled&quot;:true}]" jcr:primaryType="nt:unstructured"/>
                </removebutton>
            </items>
        </repeatableInner>
        <tertiarybutton
            jcr:created="{Date}2025-01-01T00:00:00.000Z"
            jcr:createdBy="{{ author }}"
            jcr:lastModified="{Date}2025-01-01T00:00:00.000Z"
            jcr:lastModifiedBy="{{ author }}"
            jcr:primaryType="nt:unstructured"
            jcr:title="Add"
            sling:resourceType="{{ variables.custom_resource_type_base }}/controls/tertiarybutton"
            dorExclusion="true"
            dorFieldStyling="{{ variables.dor_field_styling }}"
            guideNodeClass="guideButton"
            name="BT_Add"
            textIsRich="[true,true]"
            type="Button">
            <fd:rules jcr:primaryType="nt:unstructured"/>
            <fd:scripts fd:click="[{&quot;script&quot;:{&quot;content&quot;:&quot;{{ panel_name }}.instanceManager.addInstance();\var len = {{ panel_name }}.instanceManager.instances.length;\for (var i = 0; i &lt; len; i++) {\{{ panel_name }}.instanceManager.instances[i].BT_Remove.visible = (i === (len - 1) &amp;&amp; len &gt; 1) ? true : false;\}\if (len &gt;= {{ max_occur }}) {\this.visible = false;\}&quot;\,&quot;event&quot;:&quot;Click&quot;\,&quot;field&quot;:&quot;BT_Add&quot;}\,&quot;nodeName&quot;:&quot;SCRIPTMODEL&quot;\,&quot;version&quot;:1\,&quot;enabled&quot;:true}]" fd:init="[{&quot;script&quot;:{&quot;content&quot;:&quot;var len = {{ panel_name }}.instanceManager.instances.length;\for (var i = 0; i &lt; len; i++) {\{{ panel_name }}.instanceManager.instances[i].BT_Remove.visible = (i === (len - 1) &amp;&amp; len &gt; 1) ? true : false;\}\if (len &gt;= {{ max_occur }}) {\this.visible = false;\}&quot;\,&quot;event&quot;:&quot;Initialize&quot;\,&quot;field&quot;:&quot;BT_Add&quot;}\,&quot;nodeName&quot;:&quot;SCRIPTMODEL&quot;\,&quot;version&quot;:1\,&quot;enabled&quot;:true}]" jcr:primaryType="nt:unstructured"/>
        </tertiarybutton>
    </items>
    {{ raw_children }}
</{{ element_name }}>
