<{{ element_name }}
    jcr:created="{Date}2025-01-01T00:00:00.000Z"
    jcr:createdBy="{{ author }}"
    jcr:lastModified="{Date}2025-01-01T00:00:00.000Z"
    jcr:lastModifiedBy="{{ author }}"
    jcr:primaryType="nt:unstructured"
    {% if label and label != "" %}jcr:title="{{ label }}"{% endif %}
    sling:resourceType="{{ variables.custom_resource_type_base }}/controls/datepicker"
    css="{{ variables.css_datepicker }}"
    defaultToCurrentDate="true"
    {% if dor_colspan %}dorColspan="{{ dor_colspan }}"{% endif %}
    dorFieldStyling="{{ variables.dor_field_styling }}"
    guideNodeClass="guideDatePicker"
    mandatory="{{ mandatory }}"
    name="{{ name }}"
    {% if bind_ref %}bindRef="{{ bind_ref }}"{% endif %}
    placeholderText=""
    textIsRich="[true,true]"
    validatePictureClause="date{YYYY-MM-DD}"
    validatePictureClauseMessage="Please enter the date using the format YYYY-MM-DD."
    validationPatternType="custom"
    {% if not visible %}visible="{Boolean}false"
    dorExclusion="true"{% endif %}
    yearRangeFrom="100"
    yearRangeTo="10">
    <cq:responsive jcr:primaryType="nt:unstructured">
        <default jcr:primaryType="nt:unstructured" offset="0" width="{{ colspan }}"/>
    </cq:responsive>
</{{ element_name }}>
