<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:fd="http://www.adobe.com/aemfd/fd/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:designPath="/libs/settings/wcm/designs/fd/af/default"
        cq:deviceGroups="mobile/groups/responsive"
        cq:lastModified="{Date}2025-01-01T00:00:00.000+01:00"
        cq:lastModifiedBy="blueprint"
        cq:template="/libs/fd/af/templateForFragment/defaultFragmentTemplate"
        jcr:primaryType="cq:PageContent"
        jcr:title="UBS Fragment - Signature 1"
        sling:resourceType="fd/af/components/page/basePageForFragment"
        ignoreTranslationInvalidation="{Boolean}true">
        <guideContainer
            fd:version="1.1"
            jcr:primaryType="nt:unstructured"
            sling:resourceType="fd/af/components/guideFragmentContainer"
            fragmentModelRoot="/SignatureType"
            guideCss="guideContainer"
            guideNodeClass="guideContainerNode"
            name="fragment1"
            schemaType="xmlschema"
            xsdRef="/content/dam/formsanddocuments/afforms_xsd/AFFragments/Signature.xsd">
            <layout
                jcr:primaryType="nt:unstructured"
                sling:resourceType="fd/af/layouts/defaultGuideLayout"
                toolbarPosition="Bottom"/>
            <rootPanel
                jcr:primaryType="nt:unstructured"
                sling:resourceType="fd/af/components/rootPanel"
                guideNodeClass="rootPanelNode"
                name="guideRootPanel"
                panelSetType="Navigable">
                <layout
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="fd/af/layouts/gridFluidLayout2"
                    nonNavigable="{Boolean}true"
                    toolbarPosition="Bottom"/>
                <items
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="fd/af/layouts/gridFluidLayout2">
                    <panel_signature
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/panel"
                        dorExcludeDescription="true"
                        dorExcludeTitle="true"
                        dorExclusion="true"
                        dorFieldStyling="Default"
                        guideNodeClass="guidePanel"
                        name="PN_Signature"
                        textIsRich="true"
                        validateOnStepCompletion="{Boolean}false">
                        <layout
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="fd/af/layouts/gridFluidLayout2"
                            columns="2"
                            dorLayoutType="columnar"
                            dorNumCols="2"
                            nonNavigable="{Boolean}true"
                            toolbarPosition="Bottom"/>
                        <items
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="fd/af/layouts/gridFluidLayout2">
                            <textbox_place
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Place"
                                sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/textbox"
                                bindRef="/SignatureType/Place"
                                css="widget_ajila-forms-ubs-textbox"
                                guideNodeClass="guideTextBox"
                                name="TXT_Place_Signature"
                                textIsRich="[true,true,true,true]"/>
                            <textbox_name
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Name"
                                sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/textbox"
                                bindRef="/SignatureType/Name"
                                css="widget_ajila-forms-ubs-textbox"
                                guideNodeClass="guideTextBox"
                                name="TXT_Name_Signature"
                                textIsRich="[true,true,true,true]"/>
                            <datepicker_date
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Date"
                                sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/datepicker"
                                bindRef="/SignatureType/Date"
                                css="widget_ajila-forms-ubs-datepicker"
                                guideNodeClass="guideDatePicker"
                                name="DPK_Date_Signature"/>
                            <textbox_role
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Role"
                                sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/textbox"
                                bindRef="/SignatureType/Role"
                                css="widget_ajila-forms-ubs-textbox"
                                guideNodeClass="guideTextBox"
                                name="TXT_Role_Signature"
                                textIsRich="[true,true,true,true]"/>
                            <textbox_ouref
                                jcr:primaryType="nt:unstructured"
                                jcr:title="OU Ref"
                                sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/textbox"
                                bindRef="/SignatureType/OURef"
                                css="widget_ajila-forms-ubs-textbox"
                                guideNodeClass="guideTextBox"
                                name="TXT_OURef_Signature"
                                textIsRich="[true,true,true,true]"/>
                        </items>
                    </panel_signature>
                </items>
            </rootPanel>
        </guideContainer>
    </jcr:content>
</jcr:root>
