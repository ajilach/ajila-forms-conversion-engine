<{{ element_name }}
    jcr:created="{Date}2025-01-01T00:00:00.000Z"
    jcr:createdBy="{{ author }}"
    jcr:lastModified="{Date}2025-01-01T00:00:00.000+01:00"
    jcr:lastModifiedBy="{{ author }}"
    jcr:primaryType="nt:unstructured"
    sling:resourceType="fd/af/components/panel"
    dorExcludeDescription="true"
    dorExcludeTitle="true"
    {% if frag_ref is ending_with("affrg_BankingRelationship1") %}dorExclusion="true"{% endif %}
    dorFieldStyling="{{ variables.dor_field_styling }}"
    fragRef="{{ frag_ref }}"
    guideNodeClass="guidePanel"
    name="{{ name }}"
    {% if bind_ref %}bindRef="{{ bind_ref }}"{% endif %}
    textIsRich="true"
    validateOnStepCompletion="{Boolean}false">
    <layout
        jcr:primaryType="nt:unstructured"
        sling:resourceType="{{ variables.default_layout }}"
        columns="1"
        dorLayoutType="columnar"
        dorNumCols="1"
        nonNavigable="{Boolean}true"
        toolbarPosition="Bottom"/>
    <items
        jcr:primaryType="nt:unstructured"
        sling:resourceType="{{ variables.default_layout }}"/>
    <fd:rules jcr:primaryType="nt:unstructured"/>
    {% if frag_ref is ending_with("affrg_AddressGeneric1") %}
    <fd:scripts
        fd:init="[{&quot;script&quot;:{&quot;field&quot;:&quot;this&quot;\,&quot;event&quot;:&quot;Initialize&quot;\,&quot;model&quot;:{&quot;nodeName&quot;:&quot;EVENT_SCRIPTS&quot;}\,&quot;content&quot;:&quot;window.forms.ubs.hideAFHideDor(TXT_StreetNumber);\\nwindow.forms.ubs.hideAFHideDor(TXT_AdditionalDetails_AddressBlock);\\nwindow.forms.ubs.hideAFHideDor(TXT_PostalCodeCity);\\nwindow.forms.ubs.hideAFHideDor(TXT_State_AddressBlock);\\nwindow.forms.ubs.hideAFHideDor(TXT_District_AddressBlock_APAC);&quot;}\,&quot;nodeName&quot;:&quot;SCRIPTMODEL&quot;\,&quot;version&quot;:1\,&quot;enabled&quot;:true},{&quot;script&quot;:{&quot;field&quot;:&quot;this&quot;\,&quot;event&quot;:&quot;Initialize&quot;\,&quot;model&quot;:{&quot;nodeName&quot;:&quot;EVENT_SCRIPTS&quot;}\,&quot;content&quot;:&quot;var formMetadata = window.forms.ubs.getFormMetadata();\\nwindow.forms.ubs.referencedata.getCountryList(formMetadata.mandator\, formMetadata.language\, 'DOMICILE_INDIVIDUAL'\, DD_Country_AddressBlock);&quot;}\,&quot;nodeName&quot;:&quot;SCRIPTMODEL&quot;\,&quot;version&quot;:1\,&quot;enabled&quot;:true}]"
        jcr:primaryType="nt:unstructured"/>
    {% else %}
    <fd:scripts jcr:primaryType="nt:unstructured"/>
    {% endif %}
</{{ element_name }}>
