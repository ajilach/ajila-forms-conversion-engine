<{{ element_name }}
    jcr:created="{Date}2025-01-01T00:00:00.000Z"
    jcr:createdBy="{{ author }}"
    jcr:lastModified="{Date}2025-01-01T00:00:00.000+01:00"
    jcr:lastModifiedBy="{{ author }}"
    jcr:primaryType="nt:unstructured"
    {% if not is_page and title and title != "" %}jcr:title="{{ title }}"{% endif %}
    sling:resourceType="{{ variables.custom_resource_type_base }}/controls/panel"
    {% if dor_colspan %}dorColspan="{{ dor_colspan }}"{% endif %}
    dorExcludeDescription="true"
    {% if is_page %}dorExcludeTitle="true"{% endif %}
    dorFieldStyling="{{ variables.dor_field_styling }}"
    guideNodeClass="guidePanel"
    name="{{ name }}"
    {% if bind_ref %}bindRef="{{ bind_ref }}"{% endif %}
    textIsRich="true"
    validateOnStepCompletion="{Boolean}false"
    {% if not visible %}visible="{Boolean}false"{% endif %}>
    <items jcr:primaryType="nt:unstructured" sling:resourceType="{{ variables.default_layout }}">
        {% if is_page and title and title != "" %}
        <panel_title_{{ uuid }}
            jcr:created="{Date}2025-01-01T00:00:00.000Z"
            jcr:createdBy="{{ author }}"
            jcr:lastModified="{Date}2025-01-01T00:00:00.000+01:00"
            jcr:lastModifiedBy="{{ author }}"
            jcr:primaryType="nt:unstructured"
            jcr:title="{{ title }}"
            sling:resourceType="fd/af/components/panel"
            dorExcludeDescription="true"
            dorFieldStyling="{{ variables.dor_field_styling }}"
            guideNodeClass="guidePanel"
            name="{{ name }}Title"
            textIsRich="true"
            validateOnStepCompletion="{Boolean}false">
            <layout jcr:primaryType="nt:unstructured" sling:resourceType="{{ variables.default_layout }}" columns="1" dorLayoutType="columnar" nonNavigable="{Boolean}true" toolbarPosition="Bottom"/>
            <items jcr:primaryType="nt:unstructured" sling:resourceType="{{ variables.default_layout }}">
                <titledraw_{{ uuid }}
                    jcr:created="{Date}2025-01-01T00:00:00.000Z"
                    jcr:createdBy="{{ author }}"
                    jcr:lastModified="{Date}2025-01-01T00:00:00.000Z"
                    jcr:lastModifiedBy="{{ author }}"
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="{{ variables.custom_resource_type_base }}/controls/titledraw"
                    _value="&lt;p>{{ title }}&lt;/p>&#xa;"
                    css="stepTitle"
                    dorExclusion="true"
                    dorFieldStyling="{{ variables.dor_field_styling }}"
                    guideNodeClass="guideTextDraw"
                    headingLevel="2"
                    name="TTL_{{ name | replace(from="PN_", to="") }}"
                    summaryExclusion="true"
                    textIsRich="true"/>
            </items>
        </panel_title_{{ uuid }}>
        {% endif %}
        {{ children }}
    </items>
    <layout jcr:primaryType="nt:unstructured" sling:resourceType="{{ variables.default_layout }}" columns="1" dorLayoutType="columnar"{% if dor_num_cols %} dorNumCols="{{ dor_num_cols }}"{% endif %} nonNavigable="{Boolean}true" toolbarPosition="Bottom"/>
    <cq:responsive jcr:primaryType="nt:unstructured">
        <default jcr:primaryType="nt:unstructured" offset="0" width="{{ colspan }}"/>
    </cq:responsive>
</{{ element_name }}>
